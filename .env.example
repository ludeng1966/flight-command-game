# 复制为 .env，在本机填写。不要把密钥放进浏览器代码。
DASHSCOPE_API_KEY=
AI_PROVIDER=cloud
LOCAL_AI_GPU_LAYERS=99
QWEN_COMMAND_MODEL=qwen3.7-flash
QWEN_PILOT_MODEL=qwen3.7-flash
QWEN_ASR_MODEL=qwen3-asr-flash
# 北京地域；新加坡改用 https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 语音识别若使用不同地域或密钥，单独配置；留空则沿用以上设置。
QWEN_ASR_BASE_URL=
QWEN_ASR_API_KEY=
QWEN_TIMEOUT_MS=30000
GAME_PORT=8000

# 通联播报：Inworld TTS-2 Flash。填 Portal 中的 Base64 API Key，不要再次编码。
TTS_PROVIDER=inworld
INWORLD_API_KEY=
INWORLD_VOICE_COMMANDER=Dennis
INWORLD_RATE_COMMANDER=1.12
# 塔台：清晰、中性的男声。
INWORLD_VOICE_CONTROLLER=Oliver
INWORLD_VOICE_CONTROLLER_ZH=Yichen
INWORLD_VOICE_CONTROLLER_EN=Oliver
INWORLD_VOICE_PILOT=Alex
# 两架飞机的独立音色，留空沿用通用飞行员音色。固定按单位 ID 选择。
INWORLD_VOICE_PILOT_1=
INWORLD_VOICE_PILOT_2=
# 两个飞行员均已添加 en-US 本地化后再开启；混合通联用 TTS-2 整句生成及语种标记。
INWORLD_PILOT_EN_LOCALIZED=false
INWORLD_TTS_TIMEOUT_MS=15000
# 如需浏览器本地合成，显式改为 TTS_PROVIDER=browser。
